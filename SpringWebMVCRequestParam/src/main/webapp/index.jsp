<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Samsung Store</title>

<style>
    body {
        margin: 0;
        padding: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        color: white;
    }

    .container {
        background: white;
        color: #333;
        padding: 50px;
        border-radius: 12px;
        text-align: center;
        width: 380px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }

    h2 {
        margin-bottom: 15px;
        font-size: 26px;
        letter-spacing: 1px;
    }

    p {
        font-size: 15px;
        color: #666;
        margin-bottom: 30px;
    }

    a {
        text-decoration: none;
        background: #1428a0;
        color: white;
        padding: 12px 30px;
        border-radius: 30px;
        font-size: 16px;
        font-weight: bold;
        transition: all 0.3s ease;
    }

    a:hover {
        background: #0d1b6b;
        box-shadow: 0 6px 15px rgba(20,40,160,0.4);
    }

    .brand {
        font-size: 14px;
        margin-top: 25px;
        color: #999;
    }
</style>

</head>

<body>

<div class="container">
    <h2>Welcome to Samsung Store</h2>
    <p>Explore the latest smartphones, TVs, and smart devices</p>

    <a href="showLogin">LOGIN</a>

    <div class="brand">Official Samsung E-Commerce</div>
</div>

</body>
</html>
