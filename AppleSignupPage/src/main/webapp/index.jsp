<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Apple ID</title>

    <style>
        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
            background: #f5f5f7;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #1d1d1f;
        }

        .container {
            background: #ffffff;
            padding: 45px 40px;
            border-radius: 18px;
            width: 360px;
            text-align: center;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
        }

        h2 {
            margin-bottom: 10px;
            font-size: 28px;
            font-weight: 600;
        }

        .subtitle {
            font-size: 14px;
            color: #6e6e73;
            margin-bottom: 30px;
        }

        a {
            display: block;
            text-decoration: none;
            background: #0071e3;
            color: #ffffff;
            padding: 12px;
            margin: 14px 0;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 500;
            transition: background 0.3s ease;
        }

        a:hover {
            background: #005bb5;
        }

        .secondary {
            background: #f5f5f7;
            color: #0071e3;
            border: 1px solid #d2d2d7;
        }

        .secondary:hover {
            background: #e8e8ed;
        }

        .footer {
            margin-top: 25px;
            font-size: 12px;
            color: #86868b;
        }
    </style>
</head>

<body>

<div class="container">
    <h2>Apple ID</h2>
    <div class="subtitle">
        Sign in or create your Apple ID
    </div>

    <a href="signup">Create Apple ID</a>
    <a href="signin" class="secondary">Sign In</a>

    <div class="footer">
        © 2025 Apple Inc. All rights reserved.
    </div>
</div>

</body>
</html>
